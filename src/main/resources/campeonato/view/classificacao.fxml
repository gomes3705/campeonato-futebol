<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<!-- Tabela de classificação -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="campeonato.controller.ClassificacaoController" styleClass="tela" spacing="16">
    <Label styleClass="titulo" text="Classificação"/>

    <TableView fx:id="tabelaClassificacao" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colPosicao" text="#" prefWidth="50" styleClass="coluna-numero" sortable="false"/>
            <TableColumn prefWidth="200" fx:id="colTime" text="Time" sortable="false"/>
            <TableColumn fx:id="colPontos" text="Pts" styleClass="coluna-pontos" prefWidth="70" sortable="false"/>
            <TableColumn fx:id="colJogos" text="J" prefWidth="60" styleClass="coluna-numero" sortable="false"/>
            <TableColumn fx:id="colVitorias" text="V" prefWidth="60" styleClass="coluna-numero" sortable="false"/>
            <TableColumn fx:id="colEmpates" text="E" prefWidth="60" styleClass="coluna-numero" sortable="false"/>
            <TableColumn fx:id="colDerrotas" text="D" prefWidth="60" styleClass="coluna-numero" sortable="false"/>
            <TableColumn fx:id="colGolsPro" text="GP" prefWidth="60" styleClass="coluna-numero" sortable="false"/>
            <TableColumn fx:id="colGolsContra" text="GC" prefWidth="60" styleClass="coluna-numero" sortable="false"/>
            <TableColumn fx:id="colSaldo" text="SG" prefWidth="60" styleClass="coluna-numero" sortable="false"/>
        </columns>
        <placeholder>
            <Label text="Nenhum time cadastrado."/>
        </placeholder>
    </TableView>

    <Label styleClass="texto"
           text="J: jogos | V: vitórias | E: empates | D: derrotas | GP: gols pró | GC: gols contra | SG: saldo de gols. Ordem: pontos e, em caso de empate, saldo de gols."
           wrapText="true"/>
</VBox>
