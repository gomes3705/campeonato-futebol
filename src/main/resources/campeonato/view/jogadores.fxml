<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Gerenciamento de jogadores e goleiros -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="campeonato.controller.JogadoresController" styleClass="tela" spacing="16">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label styleClass="titulo" text="Jogadores"/>
        <Region prefWidth="16"/>
        <Label text="Time:"/>
        <ComboBox fx:id="cbTime" promptText="Selecione um time" prefWidth="240"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblElenco" styleClass="destaque"/>
    </HBox>
    <Label fx:id="lblTecnico" styleClass="texto"/>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <VBox styleClass="painel" spacing="8" prefWidth="290" minWidth="290">
            <Label styleClass="subtitulo" text="Dados do jogador"/>
            <Label text="Tipo"/>
            <ComboBox fx:id="cbTipo" maxWidth="Infinity"/>
            <Label text="Nome"/>
            <TextField fx:id="txtNome" promptText="Ex.: Pedro Alves"/>
            <HBox spacing="8">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Idade"/>
                    <TextField fx:id="txtIdade" promptText="Ex.: 24"/>
                </VBox>
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Camisa"/>
                    <TextField fx:id="txtCamisa" promptText="Ex.: 10"/>
                </VBox>
            </HBox>
            <Label text="Posição"/>
            <TextField fx:id="txtPosicao" promptText="Ex.: Atacante"/>

            <HBox spacing="8">
                <Button fx:id="btnCadastrar" text="Cadastrar" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                        styleClass="botao-principal" onAction="#cadastrar"/>
                <Button fx:id="btnSalvar" text="Salvar" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                        onAction="#salvar"/>
            </HBox>
            <HBox spacing="8">
                <Button fx:id="btnExcluir" text="Remover" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                        styleClass="botao-perigo" onAction="#excluir"/>
                <Button text="Limpar" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="botao-secundario"
                        onAction="#limpar"/>
            </HBox>
            <Label fx:id="lblMensagem" wrapText="true"/>
        </VBox>

        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label styleClass="subtitulo" text="Elenco (selecione um jogador para editar)"/>
            <TableView fx:id="tabelaElenco" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colCamisa" text="Nº" prefWidth="50" styleClass="coluna-numero"/>
                    <TableColumn prefWidth="200" fx:id="colNome" text="Nome"/>
                    <TableColumn fx:id="colIdade" text="Idade" prefWidth="60" styleClass="coluna-numero"/>
                    <TableColumn prefWidth="200" fx:id="colPosicao" text="Posição"/>
                    <TableColumn fx:id="colGols" text="Gols" prefWidth="60" styleClass="coluna-numero"/>
                    <TableColumn fx:id="colDefesas" text="Defesas" prefWidth="75" styleClass="coluna-numero"/>
                </columns>
                <placeholder>
                    <Label text="Selecione um time com jogadores cadastrados."/>
                </placeholder>
            </TableView>
            <Label fx:id="lblDetalhe" styleClass="texto" wrapText="true"/>
            <HBox spacing="8">
                <Button fx:id="btnGol" text="+1 gol" onAction="#registrarGol"/>
                <Button fx:id="btnDefesa" text="+1 defesa" onAction="#registrarDefesa"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
