<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Gerenciamento de partidas -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="campeonato.controller.PartidasController" styleClass="tela" spacing="16">
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label styleClass="titulo" text="Partidas"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Gerar confrontos" styleClass="botao-principal" onAction="#gerarConfrontos"/>
    </HBox>
    <Label fx:id="lblMensagem" wrapText="true"/>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label fx:id="lblPendentes" styleClass="subtitulo"/>
            <TableView fx:id="tabelaPendentes" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn prefWidth="200" fx:id="colPendCasa" text="Mandante"/>
                    <TableColumn prefWidth="200" fx:id="colPendVisitante" text="Visitante"/>
                </columns>
                <placeholder>
                    <Label text="Nenhuma partida pendente. Use 'Gerar confrontos'."/>
                </placeholder>
            </TableView>

            <VBox styleClass="painel" spacing="8">
                <Label styleClass="subtitulo" text="Registrar resultado"/>
                <Label fx:id="lblSelecionada" styleClass="destaque"/>
                <HBox spacing="12">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label fx:id="lblGolsCasa" text="Gols do mandante"/>
                        <TextField fx:id="txtGolsCasa" promptText="0"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label fx:id="lblGolsVisitante" text="Gols do visitante"/>
                        <TextField fx:id="txtGolsVisitante" promptText="0"/>
                    </VBox>
                </HBox>
                <Button fx:id="btnRegistrar" text="Registrar resultado" maxWidth="Infinity"
                        styleClass="botao-principal" onAction="#registrarResultado"/>
            </VBox>
        </VBox>

        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label fx:id="lblRealizadas" styleClass="subtitulo"/>
            <TableView fx:id="tabelaHistorico" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn prefWidth="200" fx:id="colHistCasa" text="Mandante"/>
                    <TableColumn fx:id="colHistPlacar" text="Placar" prefWidth="90" styleClass="coluna-numero"/>
                    <TableColumn prefWidth="200" fx:id="colHistVisitante" text="Visitante"/>
                </columns>
                <placeholder>
                    <Label text="Nenhuma partida realizada."/>
                </placeholder>
            </TableView>
        </VBox>
    </HBox>
</VBox>
