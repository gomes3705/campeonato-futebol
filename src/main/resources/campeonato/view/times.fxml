<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Gerenciamento de times -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="campeonato.controller.TimesController" styleClass="tela" spacing="16">
    <Label styleClass="titulo" text="Times"/>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <VBox styleClass="painel" spacing="8" prefWidth="300" minWidth="300">
            <Label styleClass="subtitulo" text="Dados do time"/>
            <Label text="Nome do time"/>
            <TextField fx:id="txtNome" promptText="Ex.: Atlético Central"/>
            <Label text="Nome do técnico"/>
            <TextField fx:id="txtTecnico" promptText="Ex.: Carlos Silva"/>
            <Label text="Idade do técnico"/>
            <TextField fx:id="txtIdadeTecnico" promptText="Ex.: 45"/>

            <Button text="Cadastrar" maxWidth="Infinity" styleClass="botao-principal" onAction="#cadastrar"/>
            <Button fx:id="btnSalvar" text="Salvar alterações" maxWidth="Infinity" onAction="#salvar"/>
            <Button fx:id="btnExcluir" text="Excluir time" maxWidth="Infinity" styleClass="botao-perigo"
                    onAction="#excluir"/>
            <Button text="Limpar" maxWidth="Infinity" styleClass="botao-secundario" onAction="#limpar"/>
            <Label fx:id="lblMensagem" wrapText="true"/>
        </VBox>

        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label styleClass="subtitulo" text="Times cadastrados (selecione um para editar)"/>
            <TableView fx:id="tabelaTimes" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn prefWidth="200" fx:id="colNome" text="Time"/>
                    <TableColumn prefWidth="200" fx:id="colTecnico" text="Técnico"/>
                    <TableColumn fx:id="colJogadores" text="Jogadores" prefWidth="110" styleClass="coluna-numero"/>
                    <TableColumn fx:id="colPontos" text="Pontos" prefWidth="90" styleClass="coluna-numero"/>
                </columns>
                <placeholder>
                    <Label text="Nenhum time cadastrado."/>
                </placeholder>
            </TableView>
        </VBox>
    </HBox>
</VBox>
